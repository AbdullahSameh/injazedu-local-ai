# InjazEdu AI Control Center — test environment configuration
# Copy to .env.testing. Laravel loads this automatically when APP_ENV=testing (php artisan test).
# Database name MUST contain "_test" (Principle II) — never point this at injaz_ai.

APP_NAME="InjazEdu AI Control Center"
APP_ENV=testing
APP_KEY=CHANGE_ME_APP_KEY
APP_DEBUG=true

DB_CONNECTION=pgsql
DB_HOST=localhost
# Must match POSTGRES_HOST_PORT in the repo-root .env (default 5434 — 5432 is commonly already
# taken by a native Postgres install or another project's container).
DB_PORT=5434
DB_DATABASE=injaz_ai_test
DB_USERNAME=ai_control
DB_PASSWORD=CHANGE_ME_CONTROL

SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file

ADMIN_EMAIL=test-admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN
