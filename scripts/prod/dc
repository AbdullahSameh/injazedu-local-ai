#!/usr/bin/env bash
# docker compose for production: the base file, the production override and the repo-root .env
# (docs/runbooks/production-deployment.md). Arguments pass straight through:
#   scripts/prod/dc ps
#   scripts/prod/dc logs -f --tail 100 ai-classifier
#   scripts/prod/dc restart ai-worker
set -euo pipefail
cd "$(dirname "$0")/../.."
exec docker compose -f infra/docker-compose.yml -f infra/docker-compose.prod.yml --env-file .env "$@"
