# InjazEdu Local AI — test environment configuration
# Copy to .env.testing. Read only by apps/ai-api/tests/conftest.py and
# apps/ai-control's testing environment. Never points at a non-test database (Principle II).

# Database name MUST contain "_test", MUST differ from DATABASE_URL, and MUST be a local host —
# tests/conftest.py aborts the session before collection finishes otherwise (FR-028, SC-010).
TEST_DATABASE_URL=postgresql+psycopg://ai_migrator:CHANGE_ME_MIGRATOR@localhost:5432/injaz_ai_test
