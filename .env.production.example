# InjazEdu Local AI — PRODUCTION environment (Contabo; docs/runbooks/production-deployment.md)
# Never copied by hand: `scripts/prod/init-env.sh` writes .env (mode 600) from this file and replaces
# every CHANGE_ME... placeholder with a fresh random value, printing none of them. .env is
# gitignored; this file must never carry a working credential (FR-033).
# Development keeps .env.example. Variables not listed in the base reference keep their meaning:
# specs/001-m0-foundation/contracts/environment.md.

# Host tooling only (scripts/check.sh, the Makefile's destructive targets refuse to run here).
DEPLOYMENT_ENV=production

# --- Postgres (image superuser) ---
POSTGRES_DB=injaz_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES

# --- Database identities (research D-04) ---
AI_MIGRATOR_PASSWORD=CHANGE_ME_MIGRATOR
AI_APP_PASSWORD=CHANGE_ME_APP
AI_CONTROL_PASSWORD=CHANGE_ME_CONTROL

# --- Connection strings (init-env.sh fills the same passwords in) ---
DATABASE_URL=postgresql+psycopg://ai_app:CHANGE_ME_APP@postgres:5432/injaz_ai
MIGRATOR_DATABASE_URL=postgresql+psycopg://ai_migrator:CHANGE_ME_MIGRATOR@postgres:5432/injaz_ai
REDIS_URL=redis://redis:6379/0

# --- Control panel (Laravel) ---
APP_KEY=CHANGE_ME_APP_KEY
# Blank on purpose: the panel account is created by a one-off command that reads both from the
# operator's own shell (runbook §5). Nothing here, nothing in the running container.
ADMIN_EMAIL=
ADMIN_PASSWORD=
CONTROL_URL=https://ai-control.injazedu.co

# --- Ports ---
# Container ports (unchanged from development) and the host ports nginx proxies to — bound to
# 127.0.0.1 by infra/docker-compose.prod.yml. POSTGRES_HOST_PORT is Postgres on 127.0.0.1 only,
# for a database client over SSH (runbook §7).
API_PORT=8000
CONTROL_PORT=8080
API_HOST_PORT=18000
CONTROL_HOST_PORT=18080
POSTGRES_HOST_PORT=5434

# --- Runtime ---
LOG_LEVEL=INFO
WORKER_PROCESSES=1
WORKER_THREADS=4
WORKER_HEARTBEAT_INTERVAL_S=5
WORKER_HEARTBEAT_TTL_S=15

# --- Inference ---
# The model calls go to each profile's base_url (model_profiles, set by
# scripts/prod/set-model-endpoint.sh); this one feeds only the /health probe.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CPUSET=1-5
# Inference threads: always the number of CPUs in OLLAMA_CPUSET. More threads than CPUs makes
# llama.cpp's busy-waiting threads stall each other (measured: 0.2 vs 18.3 tokens/s).
OLLAMA_THREADS=5
OLLAMA_MEM_LIMIT=6500m
# A remote inference host's Bearer key, named by a profile's api_key_env. Blank while inference is
# local (runbook §10).
INFERENCE_API_KEY=

# --- Model Gateway (M1) ---
GATEWAY_CALL_TIMEOUT_S=180
GATEWAY_MAX_RETRIES=2
GATEWAY_RETRY_BASE_S=0.5
GATEWAY_BREAKER_THRESHOLD=5
GATEWAY_BREAKER_OPEN_S=30
GATEWAY_LANE_LEASE_TTL_S=30
GATEWAY_LANE_RENEW_S=10
GATEWAY_PROFILE_CACHE_TTL_S=30
GATEWAY_CAPTURE_PAYLOADS=false

# --- Telegram ---
# BLANK UNTIL GO-LIVE (runbook §11). With no token ai-telegram starts, logs, and exits 0.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_UPDATES=message,edited_message,my_chat_member,chat_member,message_reaction,callback_query
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_POLL_TIMEOUT_S=30
TELEGRAM_POLL_LIMIT=100
TELEGRAM_CONFLICT_STANDDOWN_COUNT=5

# --- Moderation (TG-M0…TG-M4) ---
MODERATION_BURST_GAP_S=90
MODERATION_ITEM_MAX_AGE_S=86400
MODERATION_TEXT_RETENTION_DAYS=90
MODERATION_GAP_MIN_SILENCE_S=300
MODERATION_STALL_RESYNC_S=691200
MODERATION_REDERIVE_BATCH_SIZE=500
MODERATION_TICK_INTERVAL_S=30
MODERATION_PERCENTILE_MIN_SAMPLES=10
MODERATION_INCIDENT_MAX_AGE_S=86400

# --- AI classification (TG-M5): the approved configuration ---
MODERATION_CONFIDENCE_FLOOR=0.60
MODERATION_INCIDENT_CONFIDENCE=0.85
MODERATION_CLASSIFY_MAX_ATTEMPTS=5
MODERATION_CLASSIFY_RETRY_BASE_S=30
MODERATION_PROMPT_VERSION=classify_v2

# --- AI-assisted attention (TG-M5.1 / TG-M5.3): OFF. No attention instruction is qualified. ---
MODERATION_AI_ATTENTION_FROM=
MODERATION_ATTENTION_PROMPT_VERSION=
