# InjazEdu Local AI — environment configuration
# Copy to .env and replace every CHANGE_ME... placeholder with a real value.
# .env is gitignored. This file must never carry a working credential (FR-033).
# Full reference: specs/001-m0-foundation/contracts/environment.md

# --- Postgres (image superuser) ---
POSTGRES_DB=injaz_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES

# --- Database identities (research D-04) ---
AI_MIGRATOR_PASSWORD=CHANGE_ME_MIGRATOR
AI_APP_PASSWORD=CHANGE_ME_APP
AI_CONTROL_PASSWORD=CHANGE_ME_CONTROL

# --- Connection strings ---
DATABASE_URL=postgresql+psycopg://ai_app:CHANGE_ME_APP@postgres:5432/injaz_ai
MIGRATOR_DATABASE_URL=postgresql+psycopg://ai_migrator:CHANGE_ME_MIGRATOR@postgres:5432/injaz_ai
REDIS_URL=redis://redis:6379/0

# --- Control panel (Laravel) ---
APP_KEY=CHANGE_ME_APP_KEY
ADMIN_EMAIL=CHANGE_ME@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN

# --- Optional, documented defaults ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
API_PORT=8000
CONTROL_PORT=8080
# The host port the postgres container publishes on. 5432 is frequently already bound by a
# native Postgres install (Homebrew) or another project's container — `make doctor` cannot see
# inside other listeners, so change this if `make up` fails to bind it. Containers still reach
# Postgres internally at postgres:5432 regardless of this value (research D-20).
POSTGRES_HOST_PORT=5434
LOG_LEVEL=INFO
WORKER_PROCESSES=2
WORKER_THREADS=4
WORKER_HEARTBEAT_INTERVAL_S=5
WORKER_HEARTBEAT_TTL_S=15
